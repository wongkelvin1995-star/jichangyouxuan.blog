---
import Base from '../layouts/Base.astro';
import { airports, lingdong } from '../data/airports';
import { plans, plansOf, isCustom, profileOf, fmt, planStats } from '../data/plans';
import { couponPrice } from '../data/pricing';
import { coupons } from '../data/coupons';
import { SITE } from '../data/site';

const nameOf = (s: string) => airports.find((a) => a.slug === s)?.name ?? s;
const ldPlans = plansOf('lingdongyun');
const ldProfile = profileOf('lingdongyun');
/** 灵动云常规月付档（排除定制档），按每月流量从小到大；附同名年付与用码后价格 */
const ldTiers = ldPlans
  .filter((p) => p.period === 'monthly' && !isCustom(p) && p.gbPerMonth)
  .sort((a, b) => a.gbPerMonth! - b.gbPerMonth!)
  .map((p) => {
    const y = ldPlans.find((x) => x.period === 'yearly' && x.planName === p.planName);
    return { n: p.planName, g: p.gbPerMonth!, c: p.priceCny, cc: couponPrice(p), y: y ? y.priceCny : null, yc: y ? couponPrice(y) : null };
  });
/** 穿云：年付专属档，每 30 天刷新 */
const cy = ldPlans.find((p) => p.planName.startsWith('穿云') && p.period === 'yearly' && p.gbPerMonth);
/** 其他机场的月付候选（排除定制档与灵动云） */
const pool = plans
  .filter((p) => p.period === 'monthly' && !isCustom(p) && p.gbPerMonth && p.airportSlug !== 'lingdongyun')
  .map((p) => ({ s: p.airportSlug, n: nameOf(p.airportSlug), p: p.planName, c: p.priceCny, g: p.gbPerMonth!, v: p.status === 'verified' ? 1 : 0, t: /限时|活动|首月|新用户/.test(p.note + p.planName) ? '限时价' : '' }));
const verifiedNames = planStats.verifiedBrands.map(nameOf).join('、');
const planData = {
  ld: { tiers: ldTiers, cy: cy ? { n: cy.planName, g: cy.gbPerMonth, y: cy.priceCny } : null, url: lingdong.url, line: ldProfile.lineTypes[0] ?? '', code: coupons.lingdongyun?.code ?? '' },
  pool,
  vn: verifiedNames,
  ref: SITE.referenceDate,
};
const planJson = JSON.stringify(planData).replace(/</g, '\\u003c');
/** 可收录的选档表：每月实际用量 = 档位流量 ÷ 1.2（留 20% 余量） */
const ldRows = [
  ...(cy ? [{ name: cy.planName, gb: `${cy.gbPerMonth}GB / 30 天`, cap: Math.floor(cy.gbPerMonth! / 1.2), mon: '年付专属', yr: `¥${fmt(cy.priceCny)}（约 ¥${fmt(cy.priceCny / 12)}/月）`, cp: '不参与优惠码' }] : []),
  ...ldTiers.map((t) => ({ name: t.n, gb: `${t.g}GB/月`, cap: Math.floor(t.g / 1.2), mon: `¥${fmt(t.c)}`, yr: t.y ? `¥${fmt(t.y)}（约 ¥${fmt(t.y / 12)}/月）` : '—', cp: t.cc !== null ? `月付 ¥${fmt(t.cc)}${t.yc !== null ? ` · 年付 ¥${fmt(t.yc)}` : ''}` : '不参与优惠码' })),
];
const ldDate = ldProfile.verifiedAt ?? ldProfile.collectedAt;
---
<Base
  title="根据预算选择机场｜流量估算器与预算反推每 GB 成本｜机场优选 2026"
  description="不知道该花多少钱买机场？先用流量估算器算出每月需要多少 GB，页面会按流量列出够用的套餐（灵动云编辑精选在前），再用预算反推可接受的每 GB 成本，按月付试用、年付长期的顺序选择。"
  path="/budget-guide/"
  crumbs={[{ name: '按预算选', path: '/budget-guide/' }]}
>
  <section class="container page-head">
    <span class="eyebrow">按预算选</span>
    <h1>根据预算选择机场：先算清流量，再决定花多少钱</h1>
    <p class="lead">预算有限时，最容易犯的错是先看最低价。更稳妥的顺序是：先估算每月需要多少流量，再用预算反推「每 GB 最多愿意花多少」，最后用月付做一次小额试用。下面两个小工具会帮你完成前两步。</p>
  </section>

  <section class="container" style="padding-bottom:20px" id="traffic-estimator">
    <div class="section-head">
      <h2>第一步：流量估算器</h2>
      <p>只有「走代理」的那部分上网流量才会消耗套餐，不需要把全部上网时间都算进去。下面的单位流量是典型估算值，实际会随内容与应用变化。</p>
    </div>
    <div class="calc">
      <form class="card" id="est-form" onsubmit="return false">
        <div class="field"><label for="e-web">每天网页 / 社交浏览（小时）</label><input id="e-web" type="number" inputmode="decimal" min="0" step="0.5" value="1.5" /></div>
        <div class="field"><label for="e-vid">每天在线视频（小时）</label><input id="e-vid" type="number" inputmode="decimal" min="0" step="0.5" value="0.5" /></div>
        <div class="field"><label for="e-q">视频清晰度</label>
          <select id="e-q"><option value="0.4">480p（约 0.4 GB/小时）</option><option value="0.9" selected>720p（约 0.9 GB/小时）</option><option value="2">1080p（约 2 GB/小时）</option><option value="7">4K（约 7 GB/小时）</option></select></div>
        <div class="field"><label for="e-aud">每天音乐 / 播客（小时）</label><input id="e-aud" type="number" inputmode="decimal" min="0" step="0.5" value="0" /></div>
        <div class="field"><label for="e-ai">每天 AI 对话 / 在线办公（小时）</label><input id="e-ai" type="number" inputmode="decimal" min="0" step="0.5" value="0.5" /></div>
        <div class="field"><label for="e-dl">每月大文件下载（GB）</label><input id="e-dl" type="number" inputmode="decimal" min="0" step="1" value="0" /></div>
        <div class="field"><label for="e-days">每月使用天数</label><input id="e-days" type="number" inputmode="numeric" min="1" max="31" step="1" value="30" /></div>
        <div class="field"><label for="e-budget">每月预算（元，可不填）</label><input id="e-budget" type="number" inputmode="decimal" min="0" step="1" placeholder="例如 40" /></div>
      </form>
      <div class="est-side">
        <div class="result" id="est-out" aria-live="polite"></div>
        <div class="est-plans" id="est-plans" aria-live="polite"></div>
      </div>
    </div>
    <script is:inline type="application/json" id="plan-data" set:html={planJson}></script>
    <p class="small muted" style="margin-top:14px">单位流量参考：网页/社交约 0.2 GB/小时，音乐约 0.06 GB/小时，AI 对话与在线办公约 0.03 GB/小时，视频按所选清晰度。这些是教学用的典型估算值，不代表任何服务商的实测数据。</p>
  </section>

  <section class="container section" id="budget-calc" style="padding-top:10px">
    <div class="section-head">
      <h2>第二步：用预算反推可接受的每 GB 成本</h2>
      <p>每月预算 ÷ 每月需要的流量 = 你可以接受的每 GB 成本上限。看到任何套餐，只要它的每 GB 成本高于这个数，就说明它超出你的预算范围。</p>
    </div>
    <div class="calc">
      <form class="card" onsubmit="return false">
        <div class="field"><label for="b-money">每月预算（元）</label><input id="b-money" type="number" inputmode="decimal" min="0" step="1" placeholder="例如 30" /></div>
        <div class="field"><label for="b-gb">每月需要的流量（GB）</label><input id="b-gb" type="number" inputmode="decimal" min="0" step="1" placeholder="可参考上面的估算结果" /></div>
      </form>
      <div class="result" id="bud-out" aria-live="polite"><p class="muted" style="margin:0">填入预算和流量，这里会显示每 GB 成本上限。</p></div>
    </div>
  </section>

  <section class="container section" id="lingdongyun-by-usage" style="padding-top:0">
    <div class="section-head">
      <h2>灵动云套餐按每月用量怎么选</h2>
      <p>灵动云是本站编辑精选第一（<a href="/affiliate-disclosure/">推广合作</a>）。下表按站长提供的官网截图核对的价格（{ldDate}）生成，已按 20% 余量换算：每月实际用量不超过左列数字，就可以选对应档位。</p>
    </div>
    <p class="small muted tbl-hint">表格可左右滑动，查看月付、年付和用码后价格。</p>
    <div class="table-wrap">
      <table class="tbl-nowrap">
        <thead><tr><th>每月实际用量</th><th>灵动云档位</th><th>月付</th><th>年付（折合每月）</th><th>用 {coupons.lingdongyun?.code} 后</th></tr></thead>
        <tbody>
          {ldRows.map((r) => <tr><td>≤ {r.cap} GB</td><td><b>{r.name}</b> · {r.gb}</td><td>{r.mon}</td><td>{r.yr}</td><td>{r.cp}</td></tr>)}
        </tbody>
      </table>
    </div>
    <p class="small muted" style="margin-top:12px">穿云是年付专属档，购买日起每 30 天刷新流量，不参与优惠码；用码后价格按站长登记的折扣计算，以结算页为准。季付、半年付、两年付、三年付与重置包见<a href="/airports/lingdongyun/">灵动云详细页</a>，各档的每 GB 成本见<a href="/guides/lingdongyun-plan-price-structure/">灵动云套餐价格结构解读</a>。</p>
  </section>

  <section class="container section" style="padding-top:0">
    <div class="prose">
      <h2>两个教学示例（数字均为假设）</h2>
      <p>下面的例子只用来演示算法，数字是为教学设定的假设，不对应任何真实套餐。</p>
      <div class="table-wrap">
        <table class="tbl-label-nowrap">
          <thead><tr><th>假设用户</th><th>使用习惯</th><th>估算每月流量</th><th>留 20% 余量</th></tr></thead>
          <tbody>
            <tr><td>A：轻度用户</td><td>每天网页 1.5 小时 + 720p 视频 0.5 小时</td><td>（1.5×0.2 + 0.5×0.9）×30 ≈ 22.5 GB</td><td>约 27 GB</td></tr>
            <tr><td>B：视频为主</td><td>每天网页 2 小时 + 1080p 视频 2 小时</td><td>（2×0.2 + 2×2）×30 ≈ 132 GB</td><td>约 158 GB</td></tr>
          </tbody>
        </table>
      </div>
      <p>可以看到，视频清晰度对流量的影响远大于网页浏览。如果你的预算有限，把视频清晰度调低一档，往往比换一个更便宜的套餐更有效。</p>

      <h2>预算有限时的四步选择法</h2>
      <ol>
        <li><strong>先估算，再比价：</strong>用上面的估算器得到每月需要的 GB，再留出 20% 左右的余量。</li>
        <li><strong>先月付，不急年付：</strong>第一次购买某一家，优先月付，试用一到两周再决定。详见<a href="/guides/monthly-vs-yearly-airport-plan/">月付与年付怎么选</a>。</li>
        <li><strong>按每 GB 成本比较：</strong>把套餐价格填进<a href="/prices/#calculator">价格计算器</a>，只比较同一周期、同一规则的数字。</li>
        <li><strong>把条款也算进成本：</strong>设备数量、流量倍率、退款政策都会影响真正的使用成本，见<a href="/guides/airport-buying-pitfalls-guide/">购买避坑指南</a>。</li>
      </ol>

      <h2>不同使用类型，预算应该花在哪里</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>使用类型</th><th>优先关注</th><th>可以先不追求</th></tr></thead>
          <tbody>
            <tr><td>以网页、文字、AI 对话为主</td><td>稳定可用、客户端易用、客服响应</td><td>超大流量、昂贵的专线线路</td></tr>
            <tr><td>经常看视频</td><td>每 GB 成本、流量重置方式、是否有倍率</td><td>节点数量</td></tr>
            <tr><td>手机 + 电脑 + 平板多设备</td><td>同时在线设备数、订阅格式兼容性</td><td>最低价格</td></tr>
            <tr><td>家庭共用</td><td>设备数量、流量总量、付款周期的灵活度</td><td>一次性买到最长周期</td></tr>
          </tbody>
        </table>
      </div>
      <p>想要更完整的决策流程，请继续阅读<a href="/selection-guide/">机场选购指南</a>；想从概念上理解「需求比价格更重要」，请读<a href="/guides/airport-selection-2026-budget-traffic-needs/">《机场推荐指南：如何根据预算、流量与实际需求选择机场》</a>。</p>
      <div class="callout callout-note"><b class="t">想看具体品牌？</b>浏览<a href="/airports/">34 家机场目录</a>，或查看首页的<a href="/#top5">编辑精选 TOP 5</a>。目录顺序不是测速排名。</div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var g = function (id) { return document.getElementById(id); }, n = function (id) { return parseFloat(g(id).value) || 0; };
      var out = g('est-out'); if (!out) return;
      var PD = null; try { PD = JSON.parse(g('plan-data').textContent); } catch (e) { PD = null; }
      var esc = function (s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
      var m2 = function (x) { return String(Math.round(x * 100) / 100); };
      function renderPlans(need) {
        var box = g('est-plans'); if (!box || !PD) return;
        if (!(need > 0)) { box.innerHTML = ''; return; }
        var budget = n('e-budget'), ld = PD.ld, t = null, i;
        for (i = 0; i < ld.tiers.length; i++) { if (ld.tiers[i].g >= need) { t = ld.tiers[i]; break; } }
        var over = !t; if (over) t = ld.tiers[ld.tiers.length - 1];
        var notes = [];
        if (t.y) notes.push('年付 ¥' + m2(t.y) + '，折合约 ¥' + m2(t.y / 12) + '/月');
        if (t.cc !== null) notes.push('用优惠码 ' + esc(ld.code) + '：月付约 ¥' + m2(t.cc) + (t.yc !== null ? '，年付约 ¥' + m2(t.yc) : '') + '（以结算页为准）');
        if (over) notes.push('你的建议流量超过灵动云常规档位的上限（' + t.g + 'GB/月），可以先向客服确认更大流量的方案');
        if (budget > 0 && t.c > budget) notes.push('月付比你的预算高 ¥' + m2(t.c - budget) + (t.y ? '；年付折合每月 ¥' + m2(t.y / 12) : ''));
        if (ld.cy && ld.cy.g >= need) notes.push('流量不大时也可以看「' + esc(ld.cy.n) + '」：¥' + m2(ld.cy.y) + '/年，每 30 天刷新 ' + ld.cy.g + 'GB，折合约 ¥' + m2(ld.cy.y / 12) + '/月（年付专属，不参与优惠码）');
        if (ld.line) notes.push('线路：' + esc(ld.line));
        var h = '<div class="card est-pick"><div class="est-pick-head"><span class="chip chip-sun">编辑精选 No.1</span><a class="small muted" href="/affiliate-disclosure/">推广合作</a></div>'
          + '<div class="est-pick-name">灵动云 · ' + esc(t.n) + '<span>' + t.g + 'GB/月 · ' + (over ? '常规档上限' : '流量够用的入门档') + '</span></div>'
          + '<div class="est-pick-price">¥' + m2(t.c) + '<small>/月</small></div>'
          + '<ul class="est-pick-notes">' + notes.map(function (x) { return '<li>' + x + '</li>'; }).join('') + '</ul>'
          + '<div class="btn-row est-pick-btns"><a class="btn btn-sm" href="' + esc(ld.url) + '" rel="sponsored nofollow noopener" target="_blank">前往灵动云注册</a><a class="btn btn-sm btn-ghost" href="/airports/lingdongyun/">灵动云全部套餐</a></div></div>';
        var best = {}, all = [];
        ld.tiers.forEach(function (x) { if (x.g >= need) all.push(x.c); });
        PD.pool.forEach(function (p) {
          if (p.g < need) return;
          all.push(p.c);
          if (budget > 0 && p.c > budget) return;
          var b = best[p.s]; if (!b || p.c < b.c || (p.c === b.c && p.g > b.g)) best[p.s] = p;
        });
        var list = Object.keys(best).map(function (k) { return best[k]; }).sort(function (a, b) { return a.c - b.c || b.g - a.g; });
        all.sort(function (a, b) { return a - b; });
        h += '<div class="card est-others"><h3>其他机场：流量够用的月付套餐</h3>';
        if (all.length) h += '<p class="small muted">本站资料里每月不少于 ' + Math.ceil(need) + 'GB 的月付套餐有 ' + all.length + ' 档，¥' + m2(all[0]) + ' 起，中位数约 ¥' + m2(all[Math.floor((all.length - 1) / 2)]) + '/月。下面每家只列一档，按价格从低到高' + (budget > 0 ? '，只显示 ¥' + m2(budget) + ' 以内' : '') + '。</p>';
        if (list.length) {
          h += '<ul class="est-list">' + list.slice(0, 5).map(function (p) {
            return '<li><span><a class="nm" href="/airports/' + p.s + '/">' + esc(p.n) + '</a><span class="meta">' + esc(p.p) + ' · ' + p.g + 'GB/月' + (p.t ? ' · ' + p.t : '') + '</span></span>'
              + '<span class="pr">¥' + m2(p.c) + '/月<span class="chip ' + (p.v ? 'chip-mint' : 'chip-sun') + '">' + (p.v ? '已核对' : '历史参考') + '</span></span></li>';
          }).join('') + '</ul>';
          if (list.length > 5) h += '<p class="small" style="margin:0 0 6px"><a href="/prices/">到价格比较页看全部 ' + list.length + ' 家</a></p>';
        } else {
          h += '<p class="small">' + (budget > 0 && all.length ? '预算内没有流量够用的月付套餐。可以把视频清晰度调低一档，或适当提高预算。' : '本站资料里没有单月流量这么大的月付套餐，可以到<a href="/prices/">价格比较页</a>看年付或一次性流量包。') + '</p>';
        }
        h += '<p class="small muted" style="margin:0">价格为未用优惠码的原价，排序也按原价。' + esc(PD.vn) + ' 的价格已核对，其余为 ' + esc(PD.ref) + ' 的历史参考，下单前请以官网结算页为准。</p></div>';
        box.innerHTML = h;
      }
      function est() {
        var days = Math.max(1, Math.min(31, n('e-days')));
        var day = n('e-web') * 0.2 + n('e-vid') * n('e-q') + n('e-aud') * 0.06 + n('e-ai') * 0.03;
        var mon = day * days + n('e-dl');
        var buf = mon * 1.2;
        out.innerHTML = '<div class="big">约 ' + mon.toFixed(1) + ' GB / 月</div><p class="small muted" style="margin:0">估算范围：' + (mon * 0.7).toFixed(0) + ' – ' + (mon * 1.4).toFixed(0) + ' GB（习惯会波动）</p><dl><dt>每天平均</dt><dd>' + day.toFixed(2) + ' GB</dd><dt>留 20% 余量后建议不少于</dt><dd>' + buf.toFixed(0) + ' GB</dd></dl>';
        var b = g('b-gb'); if (!b.dataset.touched) { b.value = Math.ceil(buf); bud(); }
        renderPlans(buf);
      }
      function bud() {
        var m = n('b-money'), gb = n('b-gb'), o = g('bud-out');
        if (m > 0 && gb > 0) o.innerHTML = '<div class="big">≤ ¥' + (m / gb).toFixed(2) + ' / GB</div><p class="small muted" style="margin:0">每 GB 成本高于这个数的套餐，会超出你的月预算。</p><dl><dt>每月预算</dt><dd>¥' + m.toFixed(2) + '</dd><dt>每月流量需求</dt><dd>' + gb + ' GB</dd></dl>';
        else o.innerHTML = '<p class="muted" style="margin:0">填入预算和流量，这里会显示每 GB 成本上限。</p>';
      }
      ['e-web','e-vid','e-q','e-aud','e-ai','e-dl','e-days'].forEach(function (id) { g(id).addEventListener('input', est); g(id).addEventListener('change', est); });
      g('b-gb').addEventListener('input', function () { this.dataset.touched = '1'; bud(); });
      g('b-money').addEventListener('input', function () { this.dataset.touched = '1'; bud(); });
      g('e-budget').addEventListener('input', function () { var bm = g('b-money'); if (!bm.dataset.touched) { bm.value = this.value; bud(); } est(); });
      est();
    })();
  </script>
</Base>
