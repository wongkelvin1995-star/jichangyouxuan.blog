---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const hot = ['灵动云', '暮光加速', '机场优选', '机场推荐', '便宜机场', '年付', 'IEPL', 'Clash', '小火箭', '飞V', 'firefly'];
---
<Base
  title="站内搜索｜品牌、文章与套餐问题｜机场优选 2026"
  description="机场优选 2026 站内中文搜索：覆盖 34 家机场品牌、别名、文章标题、摘要与正文，可直接输入灵动云、年付、IEPL、Clash 等关键词。"
  path="/search/"
  crumbs={[{ name: '搜索', path: '/search/' }]}
  noindex={true}
>
  <section class="container page-head">
    <span class="eyebrow">站内搜索</span>
    <h1>站内搜索</h1>
    <p class="lead">支持中文、英文和品牌别名。搜索在你的浏览器里完成，不会把你的关键词发送到服务器。</p>
    <form class="search-form" action="/search/" method="get" role="search" id="sform" style="max-width:700px">
      <label class="visually-hidden" for="q">搜索关键词</label>
      <input id="q" type="search" name="q" placeholder="例如：灵动云、年付、IEPL、Clash、飞V" autocomplete="off" autofocus />
      <button class="btn btn-sm" type="submit">搜索</button>
    </form>
    <div class="chips" aria-label="热门搜索">
      {hot.map((h) => <a class="chip chip-btn" href={`/search/?q=${encodeURIComponent(h)}`} data-q={h}>{h}</a>)}
    </div>
    <div id="status" class="count-note" style="margin-top:18px" aria-live="polite"></div>
    <div id="results"></div>
    <noscript>
      <div class="callout callout-note" style="margin-top:20px"><b class="t">搜索需要启用 JavaScript</b>你也可以直接浏览：<a href="/airports/">34 家机场目录</a>、<a href="/guides/">全部文章</a>、<a href="/faq/">常见问题</a>。</div>
    </noscript>
    <div class="callout" style="margin-top:30px;max-width:820px" id="browse">
      <b class="t">不知道搜什么？直接浏览</b>
      <ul>
        <li><a href="/airports/">34 家机场目录</a></li>
        {guides.map((g) => <li><a href={`/guides/${g.id}/`}>{g.data.title}</a></li>)}
      </ul>
    </div>
  </section>
  <script type="module" src="/js/search.js"></script>
</Base>
