[build]
  command = "npm run build"
  publish = "dist"

[[redirects]]
  from = "https://www.jichangyouxuan.blog/*"
  to = "https://jichangyouxuan.blog/:splat"
  status = 301
  force = true

[[redirects]]
  from = "/*/index.html"
  to = "/:splat/"
  status = 301
  force = true

[[redirects]]
  from = "/index.html"
  to = "/"
  status = 301
  force = true
